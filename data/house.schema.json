{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ryuka.example/schemas/house.schema.json",
  "title": "Ryuka house digital twin",
  "type": "object",
  "required": ["schemaVersion", "units", "coordinateSystem", "levels", "defaults", "footprints", "specialWalls", "roofs", "rooms"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "units": { "const": "m" },
    "coordinateSystem": {
      "type": "object",
      "required": ["x", "z", "y", "origin"],
      "additionalProperties": { "type": "string" }
    },
    "levels": { "type": "object", "additionalProperties": { "type": "number" } },
    "defaults": {
      "type": "object",
      "required": ["ceilingHeight", "wallThickness"],
      "properties": {
        "ceilingHeight": { "type": "number", "exclusiveMinimum": 0 },
        "wallThickness": { "type": "number", "exclusiveMinimum": 0 },
        "interiorWallThickness": { "type": "number", "exclusiveMinimum": 0 },
        "ceilingAllowance": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "footprints": { "type": "array", "items": { "$ref": "#/$defs/rect" } },
    "specialWalls": { "type": "array", "items": { "type": "object", "required": ["id", "x", "z0", "z1", "level", "topY"], "properties": { "note": { "type": "string" } } } },
    "guardWalls": { "type": "array", "items": { "$ref": "#/$defs/guardWall" } },
    "roofs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "footprintId", "kind", "thickness", "status"],
        "properties": {
          "id": { "type": "string" }, "footprintId": { "type": "string" },
          "kind": { "enum": ["lean_to", "gable"] },
          "thickness": { "type": "number", "exclusiveMinimum": 0 },
          "status": { "enum": ["verified", "derived", "estimated"] },
          "zNorth": { "type": "number" }, "zSouth": { "type": "number" }, "pitch": { "type": "number" },
          "baseAtZMinus0_5": { "type": "number" },
          "ridgeAxis": { "enum": ["x", "z"] }, "eaveGableEnd": { "type": "number" }, "eaveLongSide": { "type": "number" },
          "source": { "type": "string" }, "note": { "type": "string" }
        }
      }
    },
    "rooms": { "type": "array", "items": { "$ref": "#/$defs/room" } },
    "stairs": { "type": "array", "items": { "$ref": "#/$defs/stair" } }
  },
  "$comment": "walls（内壁）は正本から廃止した。roomsの各部屋ポリゴンが辺を共有する区間から scripts/build-web-data.mjs が自動導出し、generated/interior-walls.json に書き出す（$defs/wall はそのファイルの形状の説明として残す）。詳細は docs/ARCHITECTURE.md「rooms / walls について」を参照",
  "$defs": {
    "rect": {
      "type": "object",
      "required": ["id", "level", "x0", "x1", "z0", "z1", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "level": { "type": "integer", "minimum": 1 },
        "x0": { "type": "number" }, "x1": { "type": "number" }, "z0": { "type": "number" }, "z1": { "type": "number" },
        "status": { "enum": ["verified", "derived", "estimated"] }
      }
    },
    "room": {
      "type": "object",
      "required": ["id", "level", "label", "polygon", "status"],
      "properties": {
        "id": { "type": "string" }, "level": { "type": "integer", "minimum": 1 }, "label": { "type": "string" },
        "polygon": { "type": "array", "minItems": 3, "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } },
        "status": { "enum": ["verified", "derived", "estimated"] }, "note": { "type": "string" },
        "ceiling": { "enum": ["sloped"] }
      }
    },
    "wall": {
      "type": "object",
      "required": ["id", "level", "x0", "x1", "z0", "z1", "orientation", "status"],
      "properties": {
        "id": { "type": "string" }, "level": { "type": "integer", "minimum": 1 },
        "x0": { "type": "number" }, "x1": { "type": "number" }, "z0": { "type": "number" }, "z1": { "type": "number" },
        "orientation": { "enum": ["H", "V"] }, "status": { "enum": ["verified", "derived", "estimated"] },
        "sourceRooms": { "type": "array", "items": { "type": "string" } }
      }
    },
    "guardWall": {
      "type": "object",
      "required": ["id", "label", "level", "orientation", "at", "from", "to", "height", "status"],
      "properties": {
        "id": { "type": "string" }, "label": { "type": "string" }, "level": { "type": "integer", "minimum": 1 },
        "orientation": { "enum": ["H", "V"] },
        "at": { "type": "number" }, "from": { "type": "number" }, "to": { "type": "number" },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "status": { "enum": ["verified", "derived", "estimated"] }, "note": { "type": "string" }
      }
    },
    "stair": {
      "type": "object",
      "required": ["id", "label", "levelFrom", "levelTo", "width", "totalSteps", "segments", "status"],
      "properties": {
        "id": { "type": "string" }, "label": { "type": "string" },
        "levelFrom": { "type": "integer", "minimum": 1 }, "levelTo": { "type": "integer", "minimum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "totalSteps": { "type": "integer", "exclusiveMinimum": 0 },
        "opening": {
          "type": "object",
          "required": ["x0", "x1", "z0", "z1"],
          "properties": {
            "x0": { "type": "number" }, "x1": { "type": "number" }, "z0": { "type": "number" }, "z1": { "type": "number" }
          }
        },
        "hiddenBelow": {
          "type": "object",
          "required": ["x0", "x1", "z0", "z1"],
          "properties": {
            "x0": { "type": "number" }, "x1": { "type": "number" }, "z0": { "type": "number" }, "z1": { "type": "number" }
          }
        },
        "segments": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "oneOf": [
              {
                "required": ["type", "x0", "z0", "x1", "z1"],
                "properties": {
                  "type": { "const": "straight" },
                  "x0": { "type": "number" }, "z0": { "type": "number" }, "x1": { "type": "number" }, "z1": { "type": "number" }
                }
              },
              {
                "required": ["type", "pivotX", "pivotZ", "radius", "startAngleDeg", "endAngleDeg"],
                "properties": {
                  "type": { "const": "arc" },
                  "pivotX": { "type": "number" }, "pivotZ": { "type": "number" },
                  "radius": { "type": "number", "exclusiveMinimum": 0 },
                  "startAngleDeg": { "type": "number" }, "endAngleDeg": { "type": "number" }
                }
              }
            ]
          }
        },
        "status": { "enum": ["verified", "derived", "estimated"] }, "note": { "type": "string" }
      }
    }
  }
}

